@{
    ViewData["Title"] = "Falha!";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center">
                <h1 class="display-4 text-danger">Ocorreu um problema!</h1>
                <img src="~/images/warning.jpg" style="width:700px" class="m-3" />
                <p>O envio dos dados da ARP falhou. Revise as informações e <a class="nav-link" asp-area="" asp-controller="ARP" asp-action="InserirAtaRegistroPreco">tente novamente.</a></p>
            </div>            
            
        </div>
    </div>
</div>
