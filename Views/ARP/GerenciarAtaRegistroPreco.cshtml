@model PublicadorARP.Models.ViewModels.AtaRegistroPrecoViewModel

@{
    ViewData["Title"] = "Detalhes da ARP";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="text-center mb-4">
                <h1 class="display-4">Ata de Registro de Preço</h1>
                <p class="lead">Detalhamento dos Dados Publicados</p>
            </div>
        
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-bold">
                    Informações Gerais de Controle
                </div>
                <div class="card-body">
                    <p><strong>Número da Ata:</strong> @Model.NumeroAtaRegistroPreco / @Model.AnoAta</p>
                    <p><strong>Número de Controle PNCP:</strong> @Model.NumeroControlePNCP</p>
                    <p><strong>Data de Assinatura:</strong> @Model.DataAssinatura.ToString("dd/MM/yyyy")</p>
                    <p><strong>Início da Vigência:</strong> @Model.DataVigenciaInicio.ToString("dd/MM/yyyy")</p>
                    <p><strong>Fim da Vigência:</strong> @Model.DataVigenciaFim.ToString("dd/MM/yyyy")</p>
                    <p><strong>Data de Publicação no Portal:</strong> @Model.DataPublicacaoPncp.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="card-footer bg-light">
                    <a asp-action="ConsultarAtasPorContratacao" class="btn btn-secondary">Voltar</a>
                </div>
            </div>
        </div>
    </div>
</div>